{
  "name": "@mathiscode/pucc",
  "version": "2.2.0",
  "license": "MIT",
  "description": "Power User Console Component - A browser console command system library",
  "author": {
    "name": "Jay Mathis",
    "email": "code@mathis.network",
    "url": "https://github.com/mathiscode"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mathiscode/pucc.git"
  },
  "type": "module",
  "sideEffects": [
    "./dist/pucc.js",
    "./dist/terminal.js",
    "./src/terminal.ts",
    "./dist/chunks/*"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./terminal": {
      "types": "./dist/terminal.d.ts",
      "import": "./dist/terminal.js"
    },
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/pucc.js",
  "jsdelivr": "./dist/pucc.js",
  "files": [
    "dist",
    "!dist/index.html",
    "!dist/demo.css"
  ],
  "scripts": {
    "build": "node config/build.mjs",
    "build:dev": "node config/build.mjs --watch",
    "format": "biome format --write",
    "lint": "biome lint",
    "server": "node config/dev.mjs",
    "start": "node config/dev.mjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "biome check",
    "prepublishOnly": "pnpm run check && pnpm run type-check && pnpm test && pnpm build"
  },
  "keywords": [
    "devtools",
    "console",
    "commands",
    "browser"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.14.0",
  "peerDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@xterm/addon-fit": {
      "optional": true
    },
    "@xterm/xterm": {
      "optional": true
    }
  }
}
