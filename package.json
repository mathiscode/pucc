{
  "name": "@mathiscode/pucc",
  "version": "1.0.5",
  "license": "MIT",
  "description": "Power User Console Component - A browser console command system library",
  "author": {
    "name": "Jay Mathis",
    "email": "code@mathis.network",
    "url": "https://github.com/mathiscode"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mathiscode/pucc.git"
  },
  "main": "dist/pucc.js",
  "module": "dist/pucc.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node config/build.mjs",
    "build:dev": "node config/build.mjs --watch",
    "format": "biome format --write",
    "lint": "biome lint",
    "server": "node config/dev.mjs",
    "start": "node config/dev.mjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "biome check"
  },
  "keywords": [
    "devtools",
    "console",
    "commands",
    "browser"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^25.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chalk": "^5.6.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
